# LabLink Backend Environment Configuration

PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
FRONTEND_URL="http://localhost:5173"

# ==============================================================================
# Generative AI Configuration
# ==============================================================================
# AI_PROVIDER: 'gemini' (default, uses Google Gemini free tier API) or 'ollama' (local inference)
AI_PROVIDER=gemini
AI_ENABLED=true
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000

# Google Gemini API Key
# To obtain a free Google Gemini API key:
# 1. Visit Google AI Studio: https://aistudio.google.com/
# 2. Click "Get API key" and create a key.
# 3. Paste the key below and rename this file to .env (or copy to .env).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Local Ollama Configuration (if using local model instead of Gemini)
# 1. Install Ollama from https://ollama.com
# 2. Run: ollama run llama3.2
# 3. Set AI_PROVIDER=ollama and configure:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
